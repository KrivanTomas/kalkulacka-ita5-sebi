<Window x:Class="SmolCalc.ScientificWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmolCalc"
        mc:Ignorable="d"
        Title="ScientificWindow" Height="447" Width="450">
    <Window.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>

            </Style.Resources>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background" Value="#FFE2E2E2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        
    </Window.Resources>
    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="78*"/>
            <RowDefinition Height="296*"/>
        </Grid.RowDefinitions>

        <Label x:Name="calc_mode_label" Content="Vědecká kalkulačka" Grid.Row="0" FontFamily="Consolas" Foreground="Black" FontSize="14" FontWeight="SemiBold" ToolTip="Aktuální režim kalkulačky"/>
        <Label x:Name="expression_label" Content="Sin(e)×Rand" FontFamily="Consolas" Foreground="Black" FontSize="20" HorizontalContentAlignment="Right" Grid.Row="1" Grid.RowSpan="2"/>
        <Label x:Name="result_label" Content="0.2371258" FontFamily="Consolas" Foreground="Black" FontSize="42" HorizontalContentAlignment="Right" Grid.Row="3" Margin="0,2,0,0"/>

        <Grid Grid.Row="4" Margin="0,0,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>



            <Button Content="1" Grid.Row="1" Grid.Column="3" Tag="num" />
            <Button Content="2" Grid.Row="1" Grid.Column="4" Tag="num" />
            <Button Content="3" Grid.Row="1" Grid.Column="5" Tag="num" />
            <Button Content="4" Grid.Row="2" Grid.Column="3" Tag="num" />
            <Button Content="5" Grid.Row="2" Grid.Column="4" Tag="num" />
            <Button Content="6" Grid.Row="2" Grid.Column="5" Tag="num" />
            <Button Content="7" Grid.Row="3" Grid.Column="3" Tag="num" />
            <Button Content="8" Grid.Row="3" Grid.Column="4" Tag="num" />
            <Button Content="9" Grid.Row="3" Grid.Column="5" Tag="num" />
            <Button Content="0" Grid.Row="4" Grid.Column="4" Tag="num" />

            <Button Content="+" Grid.Row="0" Grid.Column="6" Tag="op"  ToolTip="Sčítání"/>
            <Button Content="-" Grid.Row="1" Grid.Column="6" Tag="op"  ToolTip="Odečítání"/>
            <Button Content="×" Grid.Row="2" Grid.Column="6" Tag="op"  ToolTip="Násobení"/>
            <Button Content="/" Grid.Row="3" Grid.Column="6" Tag="op"  ToolTip="Dělení"/>
            <Button Content="=" Grid.Row="4" Grid.Column="6" Tag="equals"  Background="#FFFF7373" Foreground="White" FontWeight="Bold" ToolTip="Vypočítat zadaný výraz"/>

            <Button Content="Del" Grid.Row="0" Grid.Column="5" Tag="Del"  ToolTip="Smaže posledně zadaný znak"/>
            <Button Content="Clr" Grid.Row="0" Grid.Column="4" Tag="Clr"  ToolTip="Smaže celý vstup a výstup&#x0a;Písmeno 'c'"/>
            <Button Content="." Grid.Row="4" Grid.Column="5" Tag="dot"  ToolTip="Desetinná tečka"/>
            <Button Content="+/-" Grid.Row="4" Grid.Column="3" Tag="dot"  ToolTip="Desetinná tečka"/>

            <Button Content="!" Grid.Row="1" Grid.Column="0" Tag="opSpecial"  ToolTip="Faktoriál z čísla na aktuálním vstupu"/>
            <Button Content="xⁿ" Grid.Row="1" Grid.Column="2" Tag="op"  ToolTip="Mocnina s přirozeným exponentem&#x0a;Znak '^'"/>
            <Button Content="ⁿ√" Grid.Row="2" Grid.Column="2" Tag="op"  ToolTip="Obecná Odmocnina&#x0a;Písmeno 'r'"/>
            <Button Content="ln" Grid.Row="3" Grid.Column="1" Tag="opSpecial"  ToolTip="Naturální logaritmus (logaritmus o základu e)&#x0a;Písmeno 'l'"/>
            <Button Content="logₙ" Grid.Row="4" Grid.Column="1" Tag="opSpecial" />

            <Button Content="Sin" Grid.Row="0" Grid.Column="0" Tag="opSpecial" />
            <Button Content="Cos" Grid.Row="0" Grid.Column="1" Tag="opSpecial" />
            <Button Content="Tg" Grid.Row="1" Grid.Column="0" Tag="opSpecial" />
            <Button Content="Cotg" Grid.Row="1" Grid.Column="1" Tag="opSpecial" />

            <Button Content="|x|" Grid.Row="4" Grid.Column="2" Tag="opSpecial" />
            <Button Content="(" Grid.Row="0" Grid.Column="2" Tag="opSpecial" />
            <Button Content=")" Grid.Row="0" Grid.Column="3" Tag="opSpecial" />
            <Button Content="Mod" Grid.Row="3" Grid.Column="0" Tag="opSpecial" />
            <Button Content="1/x" Grid.Row="3" Grid.Column="2" Tag="opSpecial" />
            <Button Content="e" Grid.Row="2" Grid.Column="0" Tag="opSpecial" />
            <Button Content="π" Grid.Row="2" Grid.Column="1" Tag="opSpecial" />
            <Button Content="Rand" Grid.Row="4" Grid.Column="0" Tag="opSpecial" />

        </Grid>
    </Grid>
</Window>
