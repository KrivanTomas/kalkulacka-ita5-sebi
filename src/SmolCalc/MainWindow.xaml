<Window x:Class="SmolCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmolCalc"
        mc:Ignorable="d"
        Title="Kalkulačka ITA5+Sebi" Height="479" Width="333" Background="White" Icon="/logo01.png">
    <Window.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>

            </Style.Resources>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background" Value="#FFE2E2E2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="33*"/>
            <RowDefinition Height="78*"/>
            <RowDefinition Height="298*"/>
        </Grid.RowDefinitions>

        <Label x:Name="calc_mode_label" Content="Běžná kalkulačka" Grid.Row="0" FontFamily="Consolas" Foreground="Black" FontSize="14" FontWeight="SemiBold"/>
        <Label x:Name="expression_label" Content="1+1=" FontFamily="Consolas" Foreground="Black" FontSize="20" HorizontalContentAlignment="Right" Margin="0,33,0,0" Grid.RowSpan="3"/>
        <Label x:Name="result_label" Content="2" FontFamily="Consolas" Foreground="Black" FontSize="42" HorizontalContentAlignment="Right" Grid.Row="2" Margin="0,2,0,0"/>

        <Grid Grid.Row="3" Margin="0,0,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>



            <Button Content="1" Grid.Row="1" Grid.Column="0"/>
            <Button Content="2" Grid.Row="1" Grid.Column="1"/>
            <Button Content="3" Grid.Row="1" Grid.Column="2"/>
            <Button Content="4" Grid.Row="2" Grid.Column="0"/>
            <Button Content="5" Grid.Row="2" Grid.Column="1"/>
            <Button Content="6" Grid.Row="2" Grid.Column="2"/>
            <Button Content="7" Grid.Row="3" Grid.Column="0"/>
            <Button Content="8" Grid.Row="3" Grid.Column="1"/>
            <Button Content="9" Grid.Row="3" Grid.Column="2"/>
            <Button Content="0" Grid.Row="4" Grid.Column="1"/>

            <Button Content="+" Grid.Row="0" Grid.Column="4"/>
            <Button Content="-" Grid.Row="1" Grid.Column="4"/>
            <Button Content="×" Grid.Row="2" Grid.Column="4"/>
            <Button Content="/" Grid.Row="3" Grid.Column="4"/>
            <Button Content="=" Grid.Row="4" Grid.Column="4" Background="#FFFF7373" Foreground="White" FontWeight="Bold"/>

            <Button Content="Del" Grid.Row="0" Grid.Column="3"/>
            <Button Content="Clr" Grid.Row="0" Grid.Column="2"/>
            <Button Content="," Grid.Row="4" Grid.Column="2"/>

            <Button Content="!" Grid.Row="1" Grid.Column="3"/>
            <Button Content="xⁿ" Grid.Row="2" Grid.Column="3"/>
            <Button Content="ⁿ√" Grid.Row="3" Grid.Column="3"/>
            <Button Content="ln" Grid.Row="4" Grid.Column="3"/>
        </Grid>
    </Grid>
</Window>
